APP_ENV=development
DATABASE_URL=sqlite:///./ecoroute.db
# Required in production; use a unique random value with at least 32 characters.
# Leave blank locally to generate an ephemeral development-only secret.
AUTHENTICATION_SECRET=
# Required in production; comma-separated origins are supported.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=8000
ECO_ROUTE_SEED_DATA=true
